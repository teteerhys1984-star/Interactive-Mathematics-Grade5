{
  "name": "interactive-mathematics-grade5",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run test-area-check && npm run unit-exercises-check && npm run unit-exercises-ui-check && npm run lesson-9-coverage-check && npm run lesson-10-coverage-check && npm run lesson-11-coverage-check && npm run lesson-12-coverage-check && npm run lesson-fractions-two-check && npm run lesson-tenths-one-check && npm run lesson-tenths-one-interaction-check && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "coordinate-check": "tsx scripts/coordinate-check.ts",
    "content-check": "tsx scripts/content-check.ts",
    "design-check": "tsx scripts/design-check.ts",
    "line-graphs-check": "tsx scripts/line-graphs-check.ts",
    "lesson-3-check": "tsx scripts/lesson-3-check.ts",
    "lesson-4-check": "tsx scripts/lesson-4-check.ts",
    "lesson-5-check": "tsx scripts/lesson-5-check.ts",
    "lesson-6-check": "tsx scripts/lesson-6-check.ts",
    "lesson-7-check": "tsx scripts/lesson-7-check.ts",
    "lesson-8-check": "tsx scripts/lesson-8-check.ts",
    "lesson-9-coverage-check": "tsx scripts/lesson-9-coverage-check.tsx",
    "lesson-10-coverage-check": "tsx scripts/lesson-10-coverage-check.tsx",
    "lesson-11-coverage-check": "tsx scripts/lesson-11-coverage-check.tsx",
    "lesson-12-coverage-check": "tsx scripts/lesson-12-coverage-check.tsx",
    "lesson-fractions-two-check": "tsx scripts/lesson-fractions-two-check.ts",
    "lesson-fractions-two-interaction-check": "tsx scripts/lesson-fractions-two-interaction-check.tsx",
    "lesson-tenths-one-check": "tsx scripts/lesson-tenths-one-check.ts",
    "lesson-tenths-one-interaction-check": "tsx scripts/lesson-tenths-one-interaction-check.tsx",
    "unit-1-check": "tsx scripts/unit-1-check.ts",
    "unit-exercises-check": "tsx scripts/unit-exercises-check.ts",
    "unit-exercises-coverage": "tsx scripts/unit-exercises-check.ts --write-coverage",
    "unit-exercises-ui-check": "tsx scripts/unit-exercises-ui-check.tsx",
    "browser-smoke-test": "tsx scripts/browser-smoke-test.tsx",
    "test-area-check": "tsx scripts/test-area-check.ts && tsx scripts/test-area-ui-check.tsx"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "tsx": "^4.23.15"
  }
}
